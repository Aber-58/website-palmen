---
/**
 * Unterseite zu den ergänzenden Methoden.
 *
 * Bewusst dem Therapieangebot nachgeordnet: erreichbar über das Dropdown im
 * Seitenkopf und über den Teaser am Ende von /angebot, aber ohne
 * gleichrangigen Umschalter. Der Hinweis auf die Seminar-Webseite steht am
 * Ende dieser Seite und erscheint nur, wenn in src/config.ts eine Adresse
 * hinterlegt ist.
 */
import { SEMINAR_URL, SEMINAR_URL_ANZEIGE } from "../config";
---

<section class="py-24 relative overflow-hidden bg-gradient-to-b from-secondary/10 to-secondary/20">
    <div class="container mx-auto px-6 relative z-10 max-w-7xl">
        <div class="max-w-4xl mx-auto text-center mb-12" data-aos="fade-up">
            <a
                href="/angebot"
                class="inline-flex items-center gap-2 text-primary font-medium mb-6 hover:gap-3 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 rounded"
            >
                <span aria-hidden="true">&larr;</span>
                Zurück zum Angebot
            </a>
            <h1 class="font-serif text-5xl md:text-6xl text-text mb-4">Ergänzende Methoden</h1>
            <p class="text-text/80">
                Eine Ergänzung zur Psychotherapie – kein eigenständiges Angebot.
            </p>
        </div>

        <div class="pt-8">
            <!-- Einleitung -->
            <div class="max-w-4xl mx-auto text-center mb-16 space-y-6">
                <p
                    class="text-xl md:text-2xl font-serif italic text-primary leading-relaxed mb-8"
                >
                    „Der Körper ist für mich ein Tor zur Seele.“
                </p>
                <div
                    class="text-lg text-text/90 leading-relaxed space-y-6 text-left md:text-center max-w-3xl mx-auto"
                >
                    <p>
                        Körperwahrnehmung, Bewegung, Atmung und kreative
                        Ausdrucksformen – etwa Imaginationsübungen, Schreiben,
                        Zeichnen oder die Arbeit mit Symbolen – helfen, das
                        innerlich Erlebte sichtbar und spürbar zu machen.
                    </p>
                    <p>
                        So wird Psychotherapie zu einem Erfahrungsraum, in dem
                        Denken, Fühlen und Erleben wieder miteinander in
                        Verbindung treten dürfen.
                    </p>
                </div>
            </div>

            <!-- Hintergrund zur Person -->
            <div
                class="bg-secondary/10 p-10 rounded-3xl max-w-4xl mx-auto mb-20 flex flex-col md:flex-row items-center gap-8 md:gap-12"
            >
                <div class="md:w-1/3 text-center md:text-right">
                    <div class="text-4xl font-serif text-primary mb-2">
                        2026
                    </div>
                    <div class="text-sm uppercase tracking-wider text-muted">
                        Weiterbildung
                    </div>
                </div>
                <div
                    class="md:w-2/3 text-center md:text-left text-text/80 leading-relaxed"
                >
                    <p class="mb-2">
                        Neben meiner psychotherapeutischen Ausbildung bringe ich
                        Erfahrungen als <strong class="text-primary"
                            >Fitnesstrainerin</strong
                        > und <strong class="text-primary">Wanderguide</strong> ein.
                    </p>
                    <p>
                        Ab 2026 beginne ich zudem eine Weiterbildung zur <strong
                            class="text-primary">Yogalehrerin</strong
                        >. Bewegung, Atem und Präsenz sehe ich als wertvolle
                        Wege zu mehr Erdung, Lebendigkeit und
                        Selbstverbundenheit.
                    </p>
                </div>
            </div>

            <!-- Die drei Methodenbereiche -->
            <div class="grid md:grid-cols-3 gap-8 mb-20">
                <!-- Körper -->
                <div
                    class="bg-white p-10 rounded-3xl shadow-sm hover:shadow-md border border-secondary/20 text-center transition-shadow duration-300"
                >
                    <div
                        class="w-20 h-20 mx-auto bg-secondary/20 rounded-full flex items-center justify-center text-secondary-dark mb-6"
                    >
                        <svg aria-hidden="true"
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-10 w-10"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                            ></path></svg
                        >
                    </div>
                    <h2 class="font-serif text-2xl text-text mb-2">Körper</h2>
                    <span
                        class="block text-sm uppercase tracking-widest text-muted"
                        >Wahrnehmung & Bewegung</span
                    >
                </div>
                <!-- Atem -->
                <div
                    class="bg-white p-10 rounded-3xl shadow-sm hover:shadow-md border border-secondary/20 text-center transition-shadow duration-300"
                >
                    <div
                        class="w-20 h-20 mx-auto bg-primary/20 rounded-full flex items-center justify-center text-primary mb-6"
                    >
                        <svg aria-hidden="true"
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-10 w-10"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
                            ></path></svg
                        >
                    </div>
                    <h2 class="font-serif text-2xl text-text mb-2">Atem</h2>
                    <span
                        class="block text-sm uppercase tracking-widest text-muted"
                        >Präsenz & Erdung</span
                    >
                </div>
                <!-- Kreativität -->
                <div
                    class="bg-white p-10 rounded-3xl shadow-sm hover:shadow-md border border-secondary/20 text-center transition-shadow duration-300"
                >
                    <div
                        class="w-20 h-20 mx-auto bg-accent/20 rounded-full flex items-center justify-center text-accent-dark mb-6"
                    >
                        <svg aria-hidden="true"
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-10 w-10"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
                            ></path></svg
                        >
                    </div>
                    <h2 class="font-serif text-2xl text-text mb-2">
                        Kreativität
                    </h2>
                    <span
                        class="block text-sm uppercase tracking-widest text-muted"
                        >Ausdruck & Symbole</span
                    >
                </div>
            </div>

            <!-- Zitat -->
            <div class="text-center max-w-2xl mx-auto mb-16">
                <p class="font-serif text-lg md:text-xl text-primary/80 italic">
                    „Heilung beginnt dort, wo wir uns in unserer Ganzheit
                    gesehen fühlen.“
                </p>
            </div>
        </div>

        {/*
            Der lange reservierte Platz für den Hinweis auf die Seminare.
            Bewusst sachlich und mit klarer Abgrenzung formuliert: Seminare
            sind ein gewerbliches Bildungsangebot, Psychotherapie ist
            Heilkunde. Die Berufsordnung verlangt, dass beides nicht
            vermischt wird – deshalb eigene Webseite, kein Reiter hier.

            Erscheint nur, wenn in src/config.ts eine Adresse steht.
        */}
        {
            SEMINAR_URL && (
                <aside
                    class="max-w-3xl mx-auto rounded-3xl border border-secondary/40 bg-white/60 p-8"
                    aria-labelledby="seminar-hinweis"
                >
                    <span class="block text-xs uppercase tracking-widest text-muted mb-2">
                        Gesondertes Angebot
                    </span>
                    <h2
                        id="seminar-hinweis"
                        class="font-serif text-2xl text-text mb-3"
                    >
                        Diese Methoden in Seminarform
                    </h2>
                    <p class="text-text/80 leading-relaxed mb-5">
                        Körperwahrnehmung, Atem und kreativer Ausdruck stehen
                        auch im Mittelpunkt eigener Seminare. Die laufen
                        getrennt von der Praxis: als Bildungsangebot in der
                        Gruppe, nicht als Behandlung, und ohne Erstattung durch
                        Krankenkassen.
                    </p>
                    <a
                        href={SEMINAR_URL}
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 text-primary font-medium hover:gap-3 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 rounded"
                    >
                        {SEMINAR_URL_ANZEIGE}
                        <span aria-hidden="true">&nearr;</span>
                    </a>
                </aside>
            )
        }

        <!-- Abschluss: Kontaktaufnahme -->
        <div class="mt-24 text-center max-w-3xl mx-auto">
            <p class="text-lg text-text/80 mb-8">
                Wenn Sie Fragen zu diesen Methoden haben oder ausprobieren
                möchten, ob sie zu Ihnen passen, sprechen Sie mich gerne an.
            </p>
            <a
                href="/kontakt"
                class="inline-block border-2 border-primary text-primary px-10 py-4 rounded-full hover:bg-primary hover:text-white transition-colors font-medium tracking-wide uppercase text-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
            >
                Kontakt aufnehmen
            </a>
        </div>
    </div>
</section>
