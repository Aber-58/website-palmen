---

---

<div
    x-data="{
        locked: true,
        password: '',
        error: false,
        checkPassword() {
            if (this.password === 'palmen2025') {
                this.locked = false;
                sessionStorage.setItem('site_unlocked', 'true');
            } else {
                this.error = true;
                this.password = '';
            }
        },
        init() {
            if (sessionStorage.getItem('site_unlocked') === 'true') {
                this.locked = false;
            }
        }
    }"
    x-show="locked"
    class="fixed inset-0 z-[100] bg-background flex items-center justify-center p-4"
    style="display: none;"
>
    <div
        class="bg-white p-8 md:p-12 rounded-3xl shadow-2xl max-w-md w-full text-center border border-secondary/20"
    >
        <h2 class="font-serif text-3xl text-text mb-2">Geschützter Bereich</h2>
        <p class="text-text/70 font-light mb-8">
            Bitte geben Sie das Passwort ein, um die Vorschau zu sehen.
        </p>

        <form @submit.prevent="checkPassword" class="space-y-4">
            <div>
                <input
                    type="password"
                    x-model="password"
                    class="w-full px-4 py-3 rounded-xl bg-gray-50 border border-gray-200 focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all text-center text-lg"
                    placeholder="Passwort"
                    autofocus
                />
            </div>

            <div x-show="error" class="text-red-500 text-sm" x-transition>
                Falsches Passwort. Bitte versuchen Sie es erneut.
            </div>

            <button
                type="submit"
                class="w-full bg-primary text-white font-medium py-3 px-6 rounded-xl hover:bg-opacity-90 transition-all shadow-lg hover:shadow-primary/30"
            >
                Entsperren
            </button>
        </form>

        <p class="text-xs text-text/30 mt-8">
            Privatpraxis Kathrin Palmen Preview
        </p>
    </div>
</div>
