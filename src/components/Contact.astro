---

---

<section id="kontakt" class="py-24 bg-background relative overflow-hidden">
    <div class="container mx-auto px-6 relative z-10">
        <div class="flex flex-col lg:flex-row gap-16 lg:gap-24">
            <!-- Left Side: Info -->
            <div class="w-full lg:w-5/12" data-aos="fade-right">
                <span class="text-primary font-serif italic text-xl mb-4 block"
                    >Kontakt</span
                >
                <h2 class="font-serif text-4xl md:text-5xl text-text mb-8">
                    Ich bin für Sie da.
                </h2>
                <div class="prose prose-lg text-text/90 leading-relaxed mb-12">
                    <p>
                        Der erste Schritt ist oft der schwerste. Melden Sie sich
                        gerne unverbindlich bei mir. Ich versuche, Ihnen zeitnah
                        einen Termin für ein Erstgespräch anzubieten.
                    </p>
                </div>

                <div class="space-y-8">
                    <div class="flex items-start gap-6 group">
                        <div
                            class="w-12 h-12 rounded-full bg-white border border-secondary/30 flex items-center justify-center text-primary shrink-0 group-hover:scale-110 transition-transform shadow-sm"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-5 w-5"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="1.5"
                                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                ></path>
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="1.5"
                                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                        </div>
                        <div>
                            <h4 class="font-serif text-xl text-text mb-1">
                                Praxis
                            </h4>
                            <p class="text-text/70 font-light">
                                Schillerstraße 11<br />79183 Waldkirch
                            </p>
                            <a
                                href="https://maps.google.com/?q=Schillerstraße+11,+79183+Waldkirch"
                                target="_blank"
                                class="text-primary text-sm mt-2 inline-block hover:underline"
                                >Auf Google Maps anzeigen &rarr;</a
                            >
                        </div>
                    </div>

                    <div class="flex items-start gap-6 group">
                        <div
                            class="w-12 h-12 rounded-full bg-white border border-secondary/30 flex items-center justify-center text-primary shrink-0 group-hover:scale-110 transition-transform shadow-sm"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-5 w-5"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="1.5"
                                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                                ></path>
                            </svg>
                        </div>
                        <div>
                            <h4 class="font-serif text-xl text-text mb-1">
                                Telefon
                            </h4>
                            <p class="text-text/70 font-light mb-1">
                                0163 4252042
                            </p>
                            <p class="text-sm text-text/50">
                                Bitte hinterlassen Sie eine Nachricht, ich rufe
                                zurück.
                            </p>
                        </div>
                    </div>

                    <div class="flex items-start gap-6 group">
                        <div
                            class="w-12 h-12 rounded-full bg-white border border-secondary/30 flex items-center justify-center text-primary shrink-0 group-hover:scale-110 transition-transform shadow-sm"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-5 w-5"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="1.5"
                                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                ></path>
                            </svg>
                        </div>
                        <div>
                            <h4 class="font-serif text-xl text-text mb-1">
                                E-Mail
                            </h4>
                            <a
                                href="mailto:kontakt@palmen-psychotherapie.de"
                                class="text-text/70 font-light hover:text-primary transition-colors"
                                >kontakt@palmen-psychotherapie.de</a
                            >
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Side: Form -->
            <div class="w-full lg:w-7/12" data-aos="fade-left">
                <form
                    name="contact"
                    method="POST"
                    data-netlify="true"
                    netlify-honeypot="bot-field"
                    class="bg-white p-8 md:p-12 rounded-[2.5rem] shadow-xl border border-secondary/20 space-y-8"
                >
                    <p class="hidden">
                        <label>
                            Don’t fill this out if you’re human: <input
                                name="bot-field"
                            />
                        </label>
                    </p>
                    <div class="grid md:grid-cols-2 gap-8">
                        <div class="space-y-2 group">
                            <label
                                for="name"
                                class="text-sm font-bold text-text/80 uppercase tracking-wider group-focus-within:text-primary transition-colors"
                                >Name</label
                            >
                            <input
                                type="text"
                                id="name"
                                name="name"
                                class="w-full px-0 py-3 bg-transparent border-b border-secondary/50 focus:border-primary outline-none transition-all placeholder:text-transparent text-text font-medium"
                                placeholder="Ihr Name"
                                required
                            />
                        </div>
                        <div class="space-y-2 group">
                            <label
                                for="phone"
                                class="text-sm font-bold text-text/80 uppercase tracking-wider group-focus-within:text-primary transition-colors"
                                >Telefon</label
                            >
                            <input
                                type="tel"
                                id="phone"
                                name="phone"
                                class="w-full px-0 py-3 bg-transparent border-b border-secondary/50 focus:border-primary outline-none transition-all placeholder:text-transparent text-text font-medium"
                                placeholder="Ihre Nummer"
                            />
                        </div>
                    </div>

                    <div class="space-y-2 group">
                        <label
                            for="email"
                            class="text-sm font-bold text-text/80 uppercase tracking-wider group-focus-within:text-primary transition-colors"
                            >E-Mail</label
                        >
                        <input
                            type="email"
                            id="email"
                            name="email"
                            class="w-full px-0 py-3 bg-transparent border-b border-secondary/50 focus:border-primary outline-none transition-all placeholder:text-transparent text-text font-medium"
                            placeholder="ihre@email.de"
                            required
                        />
                    </div>

                    <div class="space-y-2 group">
                        <label
                            for="message"
                            class="text-sm font-bold text-text/80 uppercase tracking-wider group-focus-within:text-primary transition-colors"
                            >Nachricht</label
                        >
                        <textarea
                            id="message"
                            name="message"
                            rows="4"
                            class="w-full px-0 py-3 bg-transparent border-b border-secondary/50 focus:border-primary outline-none transition-all placeholder:text-transparent resize-none text-text font-medium"
                            placeholder="Wie kann ich Ihnen helfen?"
                            required></textarea>
                    </div>

                    <div class="pt-4">
                        <button
                            type="submit"
                            class="w-full border-2 border-primary text-primary font-bold py-4 px-6 rounded-full hover:bg-primary hover:text-white transition-all duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 tracking-wide uppercase"
                        >
                            Nachricht senden
                        </button>
                    </div>

                    <p
                        class="text-xs text-center text-text/60 mt-4 font-medium"
                    >
                        Ihre Daten werden vertraulich behandelt.<br />
                        Bitte senden Sie keine vertraulichen Gesundheitsdaten über
                        dieses Formular, sondern nutzen Sie es nur zur ersten Kontaktaufnahme.
                    </p>
                </form>
            </div>
        </div>
    </div>
</section>
