---
/**
 * Hauptseite des Angebots: Arbeitsweise und Arbeitsschwerpunkte.
 *
 * Die sechs Schwerpunkte stehen als Liste im Kopf dieser Datei und werden
 * daraus erzeugt. Text, Farbe, Reihenfolge oder Anzahl ändern sich damit an
 * genau einer Stelle – vorher war jede Karte einzeln ausgeschrieben.
 *
 * Die Farben kommen aus tailwind.config.mjs und sind alle aus Sand,
 * Terrakotta und Pine abgeleitet, damit die sechs Töne als eine Familie
 * gelesen werden und nicht als sechs zufällige Pastellfarben.
 */

const schwerpunkte = [
	{
		titel: "Essstörungen",
		text: "Anorexie, Bulimie, Binge-Eating und dahinterliegende Selbstwertthemen.",
		flaeche: "bg-thema-rose",
		schrift: "text-thema-rose-schrift",
		rand: "border-thema-rose-schrift/20 hover:border-thema-rose-schrift/50",
		// Bewusst ein Herz statt eines Apfels: Lebensmittel-Bildsprache wird bei
		// Essstörungen vermieden, weil sie triggern kann.
		icon: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z",
	},
	{
		titel: "Psychosomatik",
		text: "Körperliche Beschwerden als Ausdruck der Seele verstehen.",
		flaeche: "bg-thema-ocker",
		schrift: "text-thema-ocker-schrift",
		rand: "border-thema-ocker-schrift/20 hover:border-thema-ocker-schrift/50",
		// Wellen: Körper und Seele in Bewegung. Vorher eine EKG-Pulslinie – die
		// war die einzige klinische Form im Satz und wirkte kalt zwischen
		// Herz und Mond. Vorher davor eine allgemeine Personen-Silhouette,
		// die zu jedem der sechs Themen gepasst hätte.
		icon: "M2 6c.6.5 1.2 1 2.5 1C7 7 7 5 9.5 5c2.5 0 2.5 2 5 2 2.6 0 2.6-2 5-2 1.3 0 1.9.5 2.5 1M2 12c.6.5 1.2 1 2.5 1C7 13 7 11 9.5 11c2.5 0 2.5 2 5 2 2.6 0 2.6-2 5-2 1.3 0 1.9.5 2.5 1M2 18c.6.5 1.2 1 2.5 1C7 19 7 17 9.5 17c2.5 0 2.5 2 5 2 2.6 0 2.6-2 5-2 1.3 0 1.9.5 2.5 1",
	},
	{
		titel: "Stress & Erschöpfung",
		text: "Burnout-Prävention, innerer Druck und Umgang mit Perfektionismus.",
		flaeche: "bg-thema-salbei",
		schrift: "text-thema-salbei-schrift",
		rand: "border-thema-salbei-schrift/20 hover:border-thema-salbei-schrift/50",
		// Vorher ein Blitz – der steht für Energie und damit für das Gegenteil
		// von Erschöpfung. Der Mond steht für Ruhe und Erholung.
		icon: "M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z",
	},
	{
		titel: "Beziehungen",
		text: "Klärung von Konflikten, Bindungsthemen und Nähe-Distanz-Dynamiken.",
		flaeche: "bg-thema-sand",
		schrift: "text-thema-sand-schrift",
		rand: "border-thema-sand-schrift/20 hover:border-thema-sand-schrift/50",
		// Zwei sich überschneidende Kreise: Nähe und Distanz, genau das Thema.
		// Vorher eine Gruppe aus fünf Figuren – bei 28 px nur noch ein Gewusel.
		// Die beiden Kreise standen zuerst nebeneinander: breit und flach, das
		// wirkte neben Herz und Mond wie ein verkleinertes Logo. Diagonal
		// versetzt füllen sie das Quadrat und haben dasselbe optische Gewicht.
		icon: "M15 9a6 6 0 11-12 0 6 6 0 0112 0zM21 15a6 6 0 11-12 0 6 6 0 0112 0z",
	},
	{
		titel: "Sinn & Identität",
		text: "Begleitung bei Lebenskrisen, Neuorientierung und innerer Suche.",
		flaeche: "bg-thema-petrol",
		schrift: "text-thema-petrol-schrift",
		rand: "border-thema-petrol-schrift/20 hover:border-thema-petrol-schrift/50",
		// Kompass: Orientierung und Neuausrichtung. Vorher ein Fragezeichen im
		// Kreis – das ist auf Webseiten das Zeichen für "Hilfe" bzw. "FAQ".
		// Der Kreis lief vorher randbündig durchs Feld (r=10) und drückte die
		// Nadel optisch weg; mit r=9 hat die Nadel wieder Luft.
		icon: "M21 12a9 9 0 11-18 0 9 9 0 0118 0zM16.24 7.76l-2.12 6.36-6.36 2.12 2.12-6.36 6.36-2.12z",
	},
	{
		titel: "Individuelle Anliegen",
		text: "Jeder Mensch ist einzigartig. Sprechen Sie mich gerne auf Ihre persönliche Situation an.",
		flaeche: "bg-thema-pine",
		schrift: "text-thema-pine-schrift",
		rand: "border-thema-pine-schrift/20 hover:border-thema-pine-schrift/50",
		// Schlichte Sprechblase – das Thema ist "sprechen Sie mich an". Vorher
		// dieselbe Blase mit drei Punkten darin: das ist das Erkennungszeichen
		// von Support-Chat-Widgets und wirkte auf einer Therapieseite fremd.
		icon: "M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z",
	},
];
---

<section
	class="py-24 relative overflow-hidden bg-gradient-to-b from-secondary/10 to-secondary/20"
>
	<div class="container mx-auto px-6 relative z-10 max-w-7xl">
		<!-- Seitenkopf -->
		<div class="max-w-3xl mx-auto text-center mb-20" data-aos="fade-up">
			<span class="text-primary font-serif italic text-xl mb-4 block"
				>Mein Angebot</span
			>
			<h1 class="font-serif text-5xl md:text-6xl text-text mb-8">
				Wege zur Heilung
			</h1>
			<p class="text-lg md:text-xl text-text/80 leading-relaxed">
				Ich begleite Sie auf Ihrem Weg zu mehr Selbstverständnis und
				innerer Freiheit. Als approbierte Psychologische
				Psychotherapeutin verbinde ich <strong
					>tiefenpsychologische Fundierung</strong
				> mit modernen, körperorientierten und kreativen Methoden.
			</p>
		</div>

		<!-- Meine Haltung -->
		<div class="max-w-4xl mx-auto mb-24 text-center" data-aos="fade-up">
			<div class="inline-block mb-6 text-primary opacity-80">
				<svg
					aria-hidden="true"
					xmlns="http://www.w3.org/2000/svg"
					class="w-12 h-12 mx-auto"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
					><path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="1"
						d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
					></path></svg
				>
			</div>
			<h2
				class="font-serif text-3xl md:text-4xl text-text mb-8 leading-snug"
			>
				Symptome als <span class="italic text-primary">Wegweiser</span>
			</h2>
			<div
				class="max-w-2xl mx-auto space-y-6 text-lg text-text/80 leading-relaxed"
			>
				<p>
					Ich verstehe Symptome nicht als bloßes „Problem“, das
					beseitigt werden soll, sondern als Ausdruck seelischer
					Themen, die verstanden und verwandelt werden möchten.
				</p>
				<p>
					Therapie ist für mich ein Weg zurück zu sich selbst: zu den
					eigenen Gefühlen, Bedürfnissen und Lebensimpulsen.
				</p>
			</div>
		</div>

		<!-- Arbeitsschwerpunkte -->
		<div class="text-center mb-16">
			<h2 class="font-serif text-4xl text-text relative inline-block">
				Arbeitsschwerpunkte
				<span
					class="absolute -bottom-4 left-1/2 -translate-x-1/2 w-20 h-1 bg-accent/30 rounded-full"
				></span>
			</h2>
		</div>

		<div
			class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-20"
			data-aos="fade-up"
		>
			{
				schwerpunkte.map((s) => (
					<div
						class={`${s.flaeche} ${s.rand} flex flex-col h-full rounded-3xl border p-8 shadow-sm hover:shadow-md transition-all duration-300`}
					>
						<div
							class={`${s.schrift} w-14 h-14 mb-6 rounded-full bg-white/70 flex items-center justify-center`}
						>
							<svg
								aria-hidden="true"
								xmlns="http://www.w3.org/2000/svg"
								class="h-7 w-7"
								fill="none"
								viewBox="0 0 24 24"
								stroke="currentColor"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="1.5"
									d={s.icon}
								/>
							</svg>
						</div>
						<h3 class="font-serif text-2xl text-text mb-3">
							{s.titel}
						</h3>
						<p class="text-text/80 leading-relaxed">{s.text}</p>
					</div>
				))
			}
		</div>

		{/*
			Ergänzende Methoden bewusst zurückhaltend: schlichter Kasten mit
			Textlink statt großer Karte. Sie sollen präsent, aber dem
			Therapieangebot nachgeordnet sein – für Seminare ist eine eigene
			Webseite geplant.
		*/}
		<aside
			class="max-w-3xl mx-auto mb-20 rounded-3xl border border-secondary/40 bg-white/60 p-8"
			aria-labelledby="methoden-teaser"
		>
			<h2 id="methoden-teaser" class="font-serif text-2xl text-text mb-3">
				Ergänzende Methoden
			</h2>
			<p class="text-text/80 leading-relaxed mb-5">
				Wenn es passt, ergänzen Körperwahrnehmung, Atem und kreativer
				Ausdruck das Gespräch. Diese Methoden stehen nicht für sich,
				sondern begleiten die Therapie.
			</p>
			<a
				href="/angebot/methoden"
				class="inline-flex items-center gap-2 text-primary font-medium hover:gap-3 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 rounded"
			>
				Mehr zu den ergänzenden Methoden
				<span aria-hidden="true">&rarr;</span>
			</a>
		</aside>

		<!-- Abschluss: Kontaktaufnahme -->
		<div class="mt-24 text-center max-w-3xl mx-auto">
			<p class="text-lg text-text/80 mb-8">
				Wenn Sie sich von meiner Arbeitsweise angesprochen fühlen oder
				Fragen zu meinem Angebot haben, können Sie gerne Kontakt mit mir
				aufnehmen. Ich freue mich darauf, Sie auf Ihrem Weg zu mehr
				Selbstverständnis, innerer Freiheit und Lebendigkeit zu
				begleiten.
			</p>
			<a
				href="/kontakt"
				class="inline-block border-2 border-primary text-primary px-10 py-4 rounded-full hover:bg-primary hover:text-white transition-colors font-medium tracking-wide uppercase text-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
			>
				Kontakt aufnehmen
			</a>
		</div>
	</div>
</section>
