---
import { Image } from "astro:assets";
import portraitImage from "../assets/portrait-profil.jpg";

/**
 * Werdegang, streng absteigend nach Startjahr.
 *
 * Vorher war die Reihenfolge gemischt und ein Eintrag in sich widersprüchlich:
 * unter der Überschrift "2016 – 2017" stand "Reha-Zentrum St. Blasien (2019-2020)".
 * Aufgelöst anhand der Jahreszahlen, die im Eintrag selbst standen – die beiden
 * Klinikstationen sind jetzt getrennt.
 *
 * TODO (Kathrin): Zeiträume einmal gegenlesen, insbesondere St. Blasien und
 * die Überschneidung von Approbationsausbildung und Lehrpraxis-Tätigkeit.
 */
const stationen = [
	{
		zeitraum: "Seit 2025",
		titel: "Privatpraxis für Psychotherapie",
		ort: "Waldkirch",
		aktuell: true,
	},
	{
		zeitraum: "2024 – 2025",
		titel: "Praktikum bei Ai Pono Hawaii",
		ort: "Dr. Anita Johnston: Ganzheitliche Arbeit mit Essstörungen",
	},
	{
		zeitraum: "2024 – 2025",
		titel: "Systemische Weiterbildungen",
		punkte: [
			"Systemisch-schamanische Ahnenarbeit",
			"Systemisches Familienstellen",
		],
	},
	{
		zeitraum: "2019 – 2020",
		titel: "Klinische Tätigkeit",
		ort: "Reha-Zentrum St. Blasien",
	},
	{
		zeitraum: "2018 – 2023",
		titel: "Approbationsausbildung",
		rolle: "Psychologische Psychotherapeutin (TP)",
		ort: "ZIST Akademie für Psychotherapie, Penzberg",
	},
	{
		zeitraum: "2017 – 2023",
		titel: "Psychotherapeutische Tätigkeit",
		ort: "Ambulante Tätigkeit in Lehrpraxen, Freiburg",
	},
	{
		zeitraum: "2016",
		titel: "Klinische Tätigkeit",
		ort: "ZfP Emmendingen",
	},
	{
		zeitraum: "2012 – 2015",
		titel: "M. Sc. Psychologie",
		ort: "Universität des Saarlandes",
	},
	{
		zeitraum: "Seit 2012",
		titel: "Kontinuierliche Fortbildung",
		ort: "Achtsamkeit, Meditation & Körperarbeit",
	},
];
---

<section
    id="ueber-mich"
    class="pt-32 pb-24 bg-accent/5 relative overflow-hidden"
>
    <div class="container mx-auto px-6 relative z-10 max-w-7xl">
        <div
            class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-24 items-start"
        >
            <!-- Bild – mobil zuerst, auf Desktop linke Spalte -->
            <div class="md:col-start-1 md:row-start-1" data-aos="fade-right">
                <div
                    class="relative max-w-md mx-auto md:mx-0"
                >
                    {/* Versetzter Rahmen hinter dem Bild. Bleibt als ruhiges
                    gestalterisches Element – vorher drehte er sich beim Hover
                    zurück, während das Bild anhob und den Schatten wechselte. */}
                    <div
                        class="absolute inset-0 bg-primary/10 rounded-3xl translate-x-4 translate-y-4 -rotate-2"
                    >
                    </div>

                    <!-- Bildrahmen -->
                    <div
                        class="relative rounded-3xl overflow-hidden shadow-md"
                    >
                        <Image
                            src={portraitImage}
                            alt="Kathrin Palmen, Psychologische Psychotherapeutin"
                            class="w-full h-auto object-cover"
                        />
                        <div
                            class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent opacity-80"
                        >
                        </div>
                        <div
                            class="absolute bottom-8 left-8 text-white pr-8"
                        >
                            <span
                                class="font-serif italic text-2xl md:text-3xl leading-tight block drop-shadow-md"
                            >
                                "Jeder Weg beginnt mit dem ersten Schritt."
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Text – auf Desktop rechte Spalte über zwei Zeilen -->
            <div
                class="md:col-start-2 md:row-start-1 md:row-span-2 sticky top-12"
                data-aos="fade-left"
            >
                <h1
                    class="font-serif text-4xl md:text-5xl text-text mb-12 transform -translate-y-2"
                >
                    Kathrin Palmen
                </h1>

                <div
                    class="prose prose-lg text-text/80 leading-relaxed mb-12 space-y-6"
                >
                    <p>
                        Mein Name ist Kathrin Palmen. Ich bin Psychologische
                        Psychotherapeutin mit Approbation und Fachkunde in
                        tiefenpsychologisch fundierter Psychotherapie und
                        arbeite in eigener Privatpraxis in einer
                        Praxisgemeinschaft in Waldkirch.
                    </p>
                    <p>
                        Zudem bin ich, genau wie Sie, ein Mensch, der die Höhen
                        und Tiefen des Lebens kennt. Ich zeichne mich durch
                        hohe Empathie, Freundlichkeit und Feinfühligkeit aus,
                        gleichzeitig durch Lebendigkeit, Klarheit und meine
                        mitunter direkte rheinländische Art.
                    </p>
                    <p>
                        Mein Weg als Therapeutin entspringt dem tiefen Wunsch,
                        Menschen und die Welt zu verstehen – und dazu
                        beizutragen, mehr Leichtigkeit, Liebe und Verbindung ins
                        Leben zu bringen. Es ist mir ein Anliegen, authentische
                        Begegnungen zu ermöglichen und Menschen darin zu
                        unterstützen, sich selbst wieder näherzukommen. Dabei
                        bleibe ich stets neugierig, offen und lernbereit –
                        sowohl in fachlicher Hinsicht als auch im persönlichen
                        Wachstum. Neben Weiterbildungen und Selbsterfahrung sind
                        mir die Natur, das Reisen und das lebendige Miteinander
                        in all seinen Facetten wertvolle Inspirationsquellen und
                        Lehren.
                    </p>
                    <p>
                        Als Therapeutin habe ich große Freude daran, Menschen
                        auf ihrem Heilungsweg zu begleiten. Ich vertraue
                        zutiefst in die innewohnende Weisheit und
                        Selbstheilungskraft jedes Menschen. Meine Aufgabe sehe
                        ich darin, einen Raum zu schaffen, in dem Menschen
                        wieder in Kontakt mit ihrem wahren Wesen treten können –
                        jenseits von Leistung, Angst und Anpassung.
                    </p>
                    <p>
                        In meiner Arbeit lege ich Wert auf eine freundliche,
                        offene und achtsame Haltung. Zugleich ist es mir
                        wichtig, Menschen ehrlich und liebevoll auch mit ihren
                        Schattenaspekten zu konfrontieren. Humor, Körperarbeit
                        und kreative Zugänge sind dabei wesentliche Elemente
                        meines therapeutischen Stils. Ich bin ein empathischer
                        und feinfühliger, zugleich klarer und strukturierter
                        Mensch mit Herz, Erdung und spiritueller Ausrichtung.
                        Ich verbinde intuitives Spüren mit analytischem Denken –
                        beides darf in meiner Arbeit Raum haben.
                    </p>
                </div>

                <!-- Unterschrift -->
                <div class="pl-4">
                    <span
                        class="text-5xl text-primary/80 transform -rotate-2 inline-block opacity-90 drop-shadow-sm"
                        style="font-family: 'Caveat', cursive;"
                        >Kathrin Palmen</span
                    >
                </div>
            </div>

            <!-- Werdegang – auf Desktop linke Spalte, zweite Zeile -->
            <div
                class="md:col-start-1 md:row-start-2 mt-12 md:mt-24"
                data-aos="fade-right"
            >
                <h3
                    class="font-serif text-3xl text-text mb-10 inline-block relative after:content-[''] after:absolute after:-bottom-3 after:left-0 after:w-16 after:h-0.5 after:bg-secondary/40"
                >
                    Mein Weg & Qualifikationen
                </h3>

                <div class="relative ml-3 md:ml-4">
                    <!-- Durchgehende senkrechte Linie -->
                    <div
                        class="absolute left-[7px] top-3 bottom-0 w-px bg-gradient-to-b from-primary/30 via-primary/20 to-transparent"
                    >
                    </div>

                    {
                        stationen.map((s, i) => (
                            <div
                                class:list={[
                                    "relative pl-12 group",
                                    i < stationen.length - 1 && "pb-12",
                                ]}
                            >
                                <div
                                    class:list={[
                                        "absolute left-0 top-1.5 w-[15px] h-[15px] rounded-full border-2 bg-white transition-all duration-300 z-10 shadow-[0_0_0_4px_rgba(255,255,255,1)]",
                                        s.aktuell
                                            ? "border-primary group-hover:bg-primary"
                                            : "border-secondary group-hover:bg-secondary",
                                    ]}
                                />
                                <div>
                                    <span
                                        class:list={[
                                            "font-bold text-xs tracking-widest uppercase mb-1 block",
                                            s.aktuell ? "text-primary" : "text-muted",
                                        ]}
                                    >
                                        {s.zeitraum}
                                    </span>
                                    <h4
                                        class:list={[
                                            "font-serif text-xl text-text leading-tight mb-2 transition-colors",
                                            s.aktuell
                                                ? "group-hover:text-primary"
                                                : "group-hover:text-secondary-dark",
                                        ]}
                                    >
                                        {s.titel}
                                    </h4>
                                    {s.rolle && (
                                        <p class="text-text/80 text-sm mb-1 font-medium">
                                            {s.rolle}
                                        </p>
                                    )}
                                    {s.ort && (
                                        <p class="text-text/80 text-sm">{s.ort}</p>
                                    )}
                                    {s.punkte && (
                                        <ul class="text-text/80 text-sm list-disc list-inside mt-2 space-y-1">
                                            {s.punkte.map((p) => (
                                                <li>{p}</li>
                                            ))}
                                        </ul>
                                    )}
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</section>
