---

---

<section id="ablauf-kosten" class="py-24 bg-primary/5 relative overflow-hidden">
    <div class="container mx-auto px-6 max-w-5xl relative z-10">
        <!-- Header -->
        <div class="text-center mb-20" data-aos="fade-up">
            <span class="text-primary font-serif italic text-lg mb-2 block"
                >Informationen</span
            >
            <h2 class="font-serif text-4xl md:text-5xl text-text mb-6">
                Ablauf & Kosten
            </h2>
            <p class="text-lg text-text/90 max-w-2xl mx-auto">
                Hier finden Sie alle wichtigen Informationen zum Ablauf einer
                Therapie und den verschiedenen Abrechnungsmöglichkeiten.
            </p>
        </div>

        <!-- Ablauf Timeline (Redesigned) -->
        <div class="mb-32">
            <h3
                class="font-serif text-3xl text-text mb-16 text-center relative inline-block left-1/2 -translate-x-1/2"
            >
                Der Weg zur Therapie
                <span
                    class="absolute -bottom-4 left-1/2 -translate-x-1/2 w-12 h-0.5 bg-primary/20"
                ></span>
            </h3>

            <!-- Timeline Container (Enhanced Background & Flow) -->
            <div class="relative max-w-3xl mx-auto space-y-12 md:space-y-24">
                <!-- Central Line (Desktop) / Left Line (Mobile) -->
                <!-- Now with a Soft Gradient & Pulse Effect -->
                <div
                    class="absolute left-6 md:left-1/2 top-4 bottom-0 w-0.5 bg-gradient-to-b from-primary/20 via-primary/40 to-transparent -translate-x-1/2 z-0 rounded-full"
                >
                </div>

                <!-- Step 1: Left (Desktop) / Right (Mobile) -->
                <div
                    class="relative flex flex-col md:flex-row group"
                    data-aos="fade-up"
                >
                    <!-- Text Side (Left on Desktop) -->
                    <div
                        class="md:w-1/2 md:pr-16 pl-20 md:pl-0 md:text-right order-2 md:order-1 pt-1"
                    >
                        <div
                            class="bg-white p-6 rounded-2xl shadow-sm border border-secondary/20 hover:shadow-md hover:border-gray-400/30 transition-all duration-300 relative"
                        >
                            <!-- Mobile Arrow (only visual trickery, simplified) -->
                            <div
                                class="absolute -left-2 top-6 w-4 h-4 bg-white border-l border-b border-secondary/20 transform rotate-45 md:hidden"
                            >
                            </div>
                            <!-- Desktop Arrow -->
                            <div
                                class="absolute -right-2 top-6 w-4 h-4 bg-white border-r border-t border-secondary/20 transform rotate-45 hidden md:block"
                            >
                            </div>

                            <span
                                class="inline-block px-3 py-1 bg-gray-100 rounded-full text-gray-600 text-xs font-bold tracking-widest uppercase mb-3"
                                >Schritt 01</span
                            >
                            <h4
                                class="font-serif text-2xl text-text mb-2 group-hover:text-gray-700 transition-colors"
                            >
                                Kontaktaufnahme
                            </h4>
                            <p
                                class="text-text/80 leading-relaxed font-light text-sm md:text-base"
                            >
                                Melden Sie sich telefonisch oder per E-Mail. Ich
                                rufe Sie zeitnah zurück, um ein erstes kurzes
                                Gespräch zu führen.
                            </p>
                        </div>
                    </div>

                    <!-- Center Dot -->
                    <div
                        class="absolute left-6 md:left-1/2 -translate-x-1/2 top-4 w-10 h-10 bg-white border-4 border-gray-300 rounded-full flex items-center justify-center z-10 shadow-lg group-hover:scale-110 group-hover:bg-gray-400 group-hover:border-white transition-all duration-500 order-1 md:order-2"
                    >
                        <span
                            class="font-sans font-bold text-gray-400 text-sm group-hover:text-white transition-colors"
                            >1</span
                        >
                    </div>

                    <!-- Spacer -->
                    <div class="md:w-1/2 md:pl-16 order-3 hidden md:block">
                    </div>
                </div>

                <!-- Step 2: Right (Desktop) / Right (Mobile) -->
                <div
                    class="relative flex flex-col md:flex-row group"
                    data-aos="fade-up"
                >
                    <div class="md:w-1/2 md:pr-16 order-2 hidden md:block">
                    </div>

                    <!-- Center Dot -->
                    <div
                        class="absolute left-6 md:left-1/2 -translate-x-1/2 top-4 w-10 h-10 bg-white border-4 border-accent rounded-full flex items-center justify-center z-10 shadow-lg group-hover:scale-110 group-hover:bg-accent group-hover:border-white transition-all duration-500 order-1"
                    >
                        <span
                            class="font-sans font-bold text-accent text-sm group-hover:text-white transition-colors"
                            >2</span
                        >
                    </div>

                    <div
                        class="md:w-1/2 md:pl-16 pl-20 pt-1 order-3 md:order-2"
                    >
                        <div
                            class="bg-white p-6 rounded-2xl shadow-sm border border-secondary/20 hover:shadow-md hover:border-accent/30 transition-all duration-300 relative"
                        >
                            <!-- Mobile Arrow -->
                            <div
                                class="absolute -left-2 top-6 w-4 h-4 bg-white border-l border-b border-secondary/20 transform rotate-45"
                            >
                            </div>

                            <span
                                class="inline-block px-3 py-1 bg-accent/10 rounded-full text-accent text-xs font-bold tracking-widest uppercase mb-3"
                                >Schritt 02</span
                            >
                            <h4
                                class="font-serif text-2xl text-text mb-2 group-hover:text-accent transition-colors"
                            >
                                Probatorik
                            </h4>
                            <p
                                class="text-text/80 leading-relaxed font-light text-sm md:text-base"
                            >
                                In 4-5 "Schnupperstunden" lernen wir uns kennen,
                                klären Anliegen und prüfen, ob die "Chemie" für
                                eine erfolgreiche Zusammenarbeit stimmt.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Step 3: Left (Desktop) / Right (Mobile) -->
                <div
                    class="relative flex flex-col md:flex-row group"
                    data-aos="fade-up"
                >
                    <div
                        class="md:w-1/2 md:pr-16 pl-20 md:pl-0 md:text-right order-2 md:order-1 pt-1"
                    >
                        <div
                            class="bg-white p-6 rounded-2xl shadow-sm border border-secondary/20 hover:shadow-md hover:border-primary/30 transition-all duration-300 relative"
                        >
                            <!-- Mobile Arrow (only visual trickery, simplified) -->
                            <div
                                class="absolute -left-2 top-6 w-4 h-4 bg-white border-l border-b border-secondary/20 transform rotate-45 md:hidden"
                            >
                            </div>
                            <!-- Desktop Arrow -->
                            <div
                                class="absolute -right-2 top-6 w-4 h-4 bg-white border-r border-t border-secondary/20 transform rotate-45 hidden md:block"
                            >
                            </div>

                            <span
                                class="inline-block px-3 py-1 bg-primary/10 rounded-full text-primary text-xs font-bold tracking-widest uppercase mb-3"
                                >Schritt 03</span
                            >
                            <h4
                                class="font-serif text-2xl text-text mb-2 group-hover:text-primary transition-colors"
                            >
                                Therapiebeginn
                            </h4>

                            <div
                                class="text-text/80 leading-relaxed font-light space-y-3 text-sm md:text-base"
                            >
                                <p>
                                    Wir entscheiden gemeinsam über das weitere
                                    Vorgehen und legen Frequenz sowie Dauer fest
                                    (meist 50 Min. wöchentlich).
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Center Dot -->
                    <div
                        class="absolute left-6 md:left-1/2 -translate-x-1/2 top-4 w-10 h-10 bg-white border-4 border-primary rounded-full flex items-center justify-center z-10 shadow-lg group-hover:scale-110 group-hover:bg-primary group-hover:border-white transition-all duration-500 order-1 md:order-2"
                    >
                        <span
                            class="font-sans font-bold text-primary text-sm group-hover:text-white transition-colors"
                            >3</span
                        >
                    </div>

                    <div class="md:w-1/2 md:pl-16 order-3 hidden md:block">
                    </div>
                </div>
            </div>
        </div>

        <!-- Kosten -->
        <div id="kosten" class="scroll-mt-32">
            <h2
                class="font-serif text-4xl md:text-5xl text-text mb-12 text-center"
            >
                Kosten & Abrechnung
            </h2>

            <div class="max-w-4xl mx-auto" x-data="{ activeTab: null }">
                <!-- Tabs -->
                <div class="flex flex-wrap justify-center gap-4 mb-12">
                    <button
                        @click="activeTab === 'privat' ? activeTab = null : activeTab = 'privat'"
                        :class="{ 'bg-primary text-white border-primary shadow-lg scale-105': activeTab === 'privat', 'bg-white text-text border-secondary/20 shadow-sm hover:border-primary hover:text-primary hover:shadow-md': activeTab !== 'privat' }"
                        class="px-6 py-3 rounded-full text-lg font-medium transition-all duration-300 border-2 focus:outline-none"
                    >
                        Privat & Beihilfe
                    </button>
                    <button
                        @click="activeTab === 'selbstzahler' ? activeTab = null : activeTab = 'selbstzahler'"
                        :class="{ 'bg-primary text-white border-primary shadow-lg scale-105': activeTab === 'selbstzahler', 'bg-white text-text border-secondary/20 shadow-sm hover:border-primary hover:text-primary hover:shadow-md': activeTab !== 'selbstzahler' }"
                        class="px-6 py-3 rounded-full text-lg font-medium transition-all duration-300 border-2 focus:outline-none"
                    >
                        Selbstzahler
                    </button>
                    <button
                        @click="activeTab === 'coaching' ? activeTab = null : activeTab = 'coaching'"
                        :class="{ 'bg-primary text-white border-primary shadow-lg scale-105': activeTab === 'coaching', 'bg-white text-text border-secondary/20 shadow-sm hover:border-primary hover:text-primary hover:shadow-md': activeTab !== 'coaching' }"
                        class="px-6 py-3 rounded-full text-lg font-medium transition-all duration-300 border-2 focus:outline-none"
                    >
                        Coaching & Beratung
                    </button>
                </div>

                <!-- Content Container -->
                <div
                    class="bg-white rounded-[2.5rem] shadow-xl border-secondary/10 transition-all duration-500 overflow-hidden"
                    :class="activeTab ? 'max-h-[2000px] opacity-100 p-8 md:p-12 border' : 'max-h-0 opacity-0 p-0 border-0'"
                >
                    <!-- Content: Privat -->
                    <div
                        x-show="activeTab === 'privat'"
                        x-transition.opacity.duration.300ms
                    >
                        <!-- ... (Existing Content, unchanged logically, just inside the conditional block) ... -->
                        <!-- I will preserve the inner content exactly as is to be safe, just wrapping it correctly -->
                        <h3
                            class="font-serif text-2xl text-text mb-6 flex items-center gap-3"
                        >
                            <span class="w-2 h-8 bg-primary rounded-full"
                            ></span>
                            Privatversicherte & Beihilfe
                        </h3>
                        <div
                            class="prose prose-lg text-text/90 leading-relaxed"
                        >
                            <p class="font-medium text-primary mb-4">
                                Bitte beachten Sie, dass ich nicht über die
                                gesetzlichen Krankenkassen abrechnen kann.
                            </p>
                            <p>
                                Private Krankenversicherungen und
                                Beihilfestellen übernehmen in der Regel die
                                Kosten einer ambulanten Psychotherapie, jedoch
                                mit unterschiedlichen Bedingungen. Bitte
                                informieren Sie sich daher vor Therapiebeginn
                                bei Ihrer Versicherung oder Beihilfestelle über
                                folgende Punkte:
                            </p>
                            <ul class="space-y-2 my-6">
                                <li class="flex items-start gap-3">
                                    <svg
                                        class="w-6 h-6 text-primary shrink-0"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        ><path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                        ></path></svg
                                    >
                                    <span
                                        >Ist Psychotherapie bei einem
                                        approbierten Psychologischen
                                        Psychotherapeuten ohne Kassenzulassung
                                        im Leistungsumfang enthalten?</span
                                    >
                                </li>
                                <li class="flex items-start gap-3">
                                    <svg
                                        class="w-6 h-6 text-primary shrink-0"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        ><path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                        ></path></svg
                                    >
                                    <span
                                        >Gibt es Einschränkungen bei der
                                        Erstattung (z. B. Anzahl der Sitzungen
                                        oder Art des Verfahrens)?</span
                                    >
                                </li>
                                <li class="flex items-start gap-3">
                                    <svg
                                        class="w-6 h-6 text-primary shrink-0"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        ><path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                        ></path></svg
                                    >
                                    <span
                                        >Welcher GOP-Satz (Gebührenordnung für
                                        Psychotherapeut*innen) wird erstattet?</span
                                    >
                                </li>
                                <li class="flex items-start gap-3">
                                    <svg
                                        class="w-6 h-6 text-primary shrink-0"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        ><path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                        ></path></svg
                                    >
                                    <span
                                        >Wie viele probatorische Sitzungen
                                        werden übernommen, und ist ein
                                        Gutachterverfahren erforderlich?</span
                                    >
                                </li>
                                <li class="flex items-start gap-3">
                                    <svg
                                        class="w-6 h-6 text-primary shrink-0"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        ><path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                        ></path></svg
                                    >
                                    <span
                                        >Welche Unterlagen und Formulare werden
                                        für die Antragstellung benötigt?</span
                                    >
                                </li>
                            </ul>
                            <p class="mb-4">
                                Ich rechne nach der Gebührenordnung für
                                Psychotherapeut*innen (GOP) ab. Der Satz pro
                                Sitzung richtet sich nach dem Aufwand und der
                                Komplexität und liegt zwischen dem 2,3- und
                                3,5-fachen Steigerungssatz.
                            </p>
                            <p class="text-sm bg-gray-50 p-4 rounded-xl mb-4">
                                <strong>Wichtig:</strong> Sollte Ihre private Krankenversicherung
                                oder Beihilfe die Kosten nur anteilig übernehmen,
                                tragen Sie die Differenz zwischen dem Erstattungssatz
                                und meinem Honorar selbst.
                            </p>
                            <p>
                                In der Regel werden die ersten fünf
                                probatorischen Sitzungen ohne vorherige
                                Genehmigung übernommen. Anschließend kann ein
                                Antrag auf Kostenübernahme für eine Kurzzeit-
                                oder Langzeittherapie gestellt werden, bei dem
                                ich Sie selbstverständlich unterstütze. Auch die
                                Kosten einer Gruppentherapie können übernommen
                                werden, sofern dies im Vertrag vorgesehen ist.
                            </p>
                        </div>
                    </div>

                    <!-- Content: Selbstzahler -->
                    <div
                        x-show="activeTab === 'selbstzahler'"
                        x-transition.opacity.duration.300ms
                        style="display: none;"
                    >
                        <!-- ... (Existing Content, unchanged) ... -->
                        <h3
                            class="font-serif text-2xl text-text mb-6 flex items-center gap-3"
                        >
                            <span class="w-2 h-8 bg-primary rounded-full"
                            ></span>
                            Selbstzahler*innen
                        </h3>
                        <div
                            class="prose prose-lg text-text/90 leading-relaxed"
                        >
                            <p class="mb-6">
                                Selbstverständlich können Sie die Kosten auch
                                selbst tragen. Dies kann neben ganz persönlichen
                                Gründen insbesondere dann sinnvoll sein, wenn
                                Sie z. B. eine Berufsunfähigkeitsversicherung
                                oder Lebensversicherung abschließen möchten und
                                vermeiden wollen, dass eine Diagnose in Ihre
                                Versicherungsakte aufgenommen wird.
                            </p>
                            <p class="mb-8">
                                Ein weiterer Vorteil der Selbstzahlung besteht
                                darin, dass die Behandlung sofort beginnen kann
                                – ganz ohne Antragsverfahren und in einer
                                Frequenz, die wir individuell abstimmen können.
                            </p>

                            <div class="grid md:grid-cols-2 gap-6 mb-8">
                                <div
                                    class="bg-white p-6 rounded-2xl border border-primary/20 shadow-sm hover:shadow-md transition-all"
                                >
                                    <span
                                        class="block text-sm text-text/80 font-bold uppercase tracking-wider mb-2"
                                        >Einzelsitzung</span
                                    >
                                    <span
                                        class="block text-3xl font-serif text-primary"
                                        >100 €</span
                                    >
                                    <span
                                        class="block text-sm text-text/80 mt-1"
                                        >pro 50 Minuten</span
                                    >
                                </div>
                                <div
                                    class="bg-gray-50 p-6 rounded-2xl border border-gray-100"
                                >
                                    <span
                                        class="block text-sm text-text/60 uppercase tracking-wider mb-2"
                                        >Gruppentherapie</span
                                    >
                                    <span
                                        class="block text-xl font-serif text-text"
                                        >Reduzierte Tarife</span
                                    >
                                    <span
                                        class="block text-sm text-text/60 mt-1"
                                        >abhängig von Gruppengröße & Frequenz</span
                                    >
                                </div>
                            </div>

                            <p class="text-sm italic">
                                * Kosten für Psychotherapie können unter
                                Umständen als „außergewöhnliche Belastungen“ (§
                                33 EStG) steuerlich geltend gemacht werden.
                            </p>
                        </div>
                    </div>

                    <!-- Content: Coaching -->
                    <div
                        x-show="activeTab === 'coaching'"
                        x-transition.opacity.duration.300ms
                        style="display: none;"
                    >
                        <!-- ... (Existing Content, unchanged) ... -->
                        <h3
                            class="font-serif text-2xl text-text mb-6 flex items-center gap-3"
                        >
                            <span class="w-2 h-8 bg-primary rounded-full"
                            ></span>
                            Beratung & Coaching
                        </h3>
                        <div
                            class="prose prose-lg text-text/90 leading-relaxed"
                        >
                            <p class="mb-8">
                                Auch Beratung, Coaching, Paar- oder
                                Familiengespräche fallen nicht unter die
                                Leistungen der Krankenversicherungen und müssen
                                privat gezahlt werden.
                            </p>

                            <div
                                class="bg-white p-8 rounded-2xl border border-primary/20 shadow-sm mb-6"
                            >
                                <h4 class="font-serif text-xl text-text mb-4">
                                    Honorarsatz
                                </h4>
                                <p class="text-text/80">
                                    Die Kosten hierfür orientieren sich am
                                    üblichen Honorarsatz für Selbstzahler*innen
                                    (siehe dort). Für Paar- und
                                    Familiengespräche wird das Honorar
                                    entsprechend angepasst.
                                </p>
                            </div>

                            <p class="text-sm">
                                * Für Coaching, Beratung oder Supervision kann
                                ggf. eine steuerliche Anrechnung als
                                Werbungskosten erfolgen.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- FAQ Section -->
        <div class="mt-24 max-w-3xl mx-auto" data-aos="fade-up">
            <h3 class="font-serif text-3xl text-text mb-12 text-center">
                Häufige Fragen
            </h3>

            <div class="space-y-4" x-data="{ selected: null }">
                <!-- FAQ Items (Unchanged conceptually, just ensuring they fit) -->
                <!-- 1 -->
                <div
                    class="bg-white border border-secondary/20 rounded-2xl overflow-hidden shadow-sm transition-all duration-300 hover:shadow-md"
                >
                    <button
                        @click="selected !== 1 ? selected = 1 : selected = null"
                        class="w-full px-6 py-5 flex items-center justify-between text-left focus:outline-none"
                    >
                        <span class="font-serif text-lg text-text font-medium"
                            >Wie lange dauert eine Sitzung?</span
                        >
                        <span
                            class="ml-4 transform transition-transform duration-300 text-primary"
                            :class="selected === 1 ? 'rotate-180' : ''"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-5 w-5"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </span>
                    </button>
                    <div
                        x-show="selected === 1"
                        x-collapse
                        class="px-6 pb-6 text-text/80 leading-relaxed"
                    >
                        Eine Therapiesitzung dauert in der Regel <strong
                            >50 Minuten</strong
                        >. Diese Zeit ist exklusiv für Sie reserviert.
                        Doppelsitzungen oder kürzere Frequenzen sind nach
                        Absprache möglich.
                    </div>
                </div>

                <!-- 2 -->
                <div
                    class="bg-white border border-secondary/20 rounded-2xl overflow-hidden shadow-sm transition-all duration-300 hover:shadow-md"
                >
                    <button
                        @click="selected !== 2 ? selected = 2 : selected = null"
                        class="w-full px-6 py-5 flex items-center justify-between text-left focus:outline-none"
                    >
                        <span class="font-serif text-lg text-text font-medium"
                            >Kann ich auch online Termine wahrnehmen?</span
                        >
                        <span
                            class="ml-4 transform transition-transform duration-300 text-primary"
                            :class="selected === 2 ? 'rotate-180' : ''"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-5 w-5"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </span>
                    </button>
                    <div
                        x-show="selected === 2"
                        x-collapse
                        class="px-6 pb-6 text-text/80 leading-relaxed"
                    >
                        Ja, ich biete auch <strong>Videosprechstunden</strong> an.
                        Dies ist besonders praktisch, wenn Sie beruflich viel unterwegs
                        sind oder nicht in die Praxis kommen können. Die Abrechnung
                        erfolgt analog zu Präsenzsitzungen.
                    </div>
                </div>

                <!-- 3 -->
                <div
                    class="bg-white border border-secondary/20 rounded-2xl overflow-hidden shadow-sm transition-all duration-300 hover:shadow-md"
                >
                    <button
                        @click="selected !== 3 ? selected = 3 : selected = null"
                        class="w-full px-6 py-5 flex items-center justify-between text-left focus:outline-none"
                    >
                        <span class="font-serif text-lg text-text font-medium"
                            >Wie schnell bekomme ich einen Termin?</span
                        >
                        <span
                            class="ml-4 transform transition-transform duration-300 text-primary"
                            :class="selected === 3 ? 'rotate-180' : ''"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-5 w-5"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </span>
                    </button>
                    <div
                        x-show="selected === 3"
                        x-collapse
                        class="px-6 pb-6 text-text/80 leading-relaxed"
                    >
                        Ich bemühe mich, Erstgespräche zeitnah anzubieten, oft
                        innerhalb von <strong>1-2 Wochen</strong>. Für einen
                        regulären Therapieplatz können Wartezeiten entstehen,
                        über die ich Sie im Erstgespräch transparent informiere.
                    </div>
                </div>

                <!-- 4 -->
                <div
                    class="bg-white border border-secondary/20 rounded-2xl overflow-hidden shadow-sm transition-all duration-300 hover:shadow-md"
                >
                    <button
                        @click="selected !== 4 ? selected = 4 : selected = null"
                        class="w-full px-6 py-5 flex items-center justify-between text-left focus:outline-none"
                    >
                        <span class="font-serif text-lg text-text font-medium"
                            >Muss ich eine Diagnose haben?</span
                        >
                        <span
                            class="ml-4 transform transition-transform duration-300 text-primary"
                            :class="selected === 4 ? 'rotate-180' : ''"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-5 w-5"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </span>
                    </button>
                    <div
                        x-show="selected === 4"
                        x-collapse
                        class="px-6 pb-6 text-text/80 leading-relaxed"
                    >
                        Für eine Kostenübernahme durch die Krankenkasse ist eine
                        Diagnose nach ICD-10 erforderlich. Wenn Sie als <strong
                            >Selbstzahler</strong
                        > kommen oder ein <strong>Coaching</strong> buchen, wird keine
                        Diagnose an die Kasse übermittelt.
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
