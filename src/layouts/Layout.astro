---
// Nur die tatsächlich benutzten Schnitte, latin-Subset (deckt Deutsch vollständig ab).
// Ohne diese Importe lieferte der Browser Fake-Bold und Fake-Kursiv – siehe README.
import "@fontsource/cormorant-garamond/latin-400.css";
import "@fontsource/cormorant-garamond/latin-400-italic.css";
import "@fontsource/cormorant-garamond/latin-600.css";
import "@fontsource/lato/latin-300.css";
import "@fontsource/lato/latin-400.css";
import "@fontsource/lato/latin-700.css";
import "@fontsource/caveat/latin-400.css";
import "aos/dist/aos.css";

import ScrollToTop from "../components/ScrollToTop.astro";

interface Props {
	/** Vollständiger <title>. Wird NICHT mehr um einen Suffix ergänzt. */
	title: string;
	/** Eigene Meta-Description je Seite. Fällt auf den Praxis-Standardtext zurück. */
	description?: string;
	/** Rechts-/Fehlerseiten sollen weder indexiert werden noch LocalBusiness-Markup tragen. */
	noindex?: boolean;
}

const SITE = "https://www.praxis-palmen.de";
const EMAIL = "info@praxis-palmen.de";
const TEL_DISPLAY = "0163 4252042";
const TEL_LINK = "+491634252042";

const {
	title,
	description = "Privatpraxis für Psychotherapie in Waldkirch bei Freiburg. Tiefenpsychologisch fundiert, körperorientiert und naturverbunden. Schwerpunkte: Essstörungen, Psychosomatik, Erschöpfung.",
	noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE).toString();

const practiceSchema = {
	"@context": "https://schema.org",
	"@type": "Psychologist",
	name: "Privatpraxis für Psychotherapie Kathrin Palmen",
	description:
		"Privatpraxis für tiefenpsychologisch fundierte Psychotherapie in Waldkirch. Keine Abrechnung über gesetzliche Krankenkassen.",
	image: `${SITE}/assets/og-praxis-palmen.jpg`,
	"@id": SITE,
	url: SITE,
	telephone: TEL_LINK,
	email: EMAIL,
	founder: {
		"@type": "Person",
		name: "Kathrin Palmen",
		honorificSuffix: "M.Sc. Psych.",
		jobTitle: "Psychologische Psychotherapeutin",
	},
	address: {
		"@type": "PostalAddress",
		streetAddress: "Schillerstraße 11",
		addressLocality: "Waldkirch",
		addressRegion: "Baden-Württemberg",
		postalCode: "79183",
		addressCountry: "DE",
	},
	geo: {
		"@type": "GeoCoordinates",
		latitude: 48.0938,
		longitude: 7.9626,
	},
	areaServed: [
		{ "@type": "City", name: "Waldkirch" },
		{ "@type": "City", name: "Freiburg im Breisgau" },
		{ "@type": "City", name: "Emmendingen" },
	],
	knowsAbout: [
		"Tiefenpsychologisch fundierte Psychotherapie",
		"Essstörungen",
		"Psychosomatik",
		"Stress und Erschöpfung",
		"Beziehungs- und Bindungsthemen",
	],
	availableLanguage: "de",
	// Bewusst KEINE openingHoursSpecification: Es gibt keine belegten Sprechzeiten.
	// Sobald Kathrin die telefonische Erreichbarkeit nennt, hier und auf /kontakt ergänzen.
};
---

<!doctype html>
<html lang="de" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		{/* favicon.ico enthält 16/32/48/64 px – je Größe mit eigener Strichstärke
		gerendert, weil die feinen Palmenlinien sonst unter 32 px verschwinden. */}
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
		<meta name="theme-color" content="#1a3c3b" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- SEO Meta Tags -->
		<link rel="canonical" href={canonical} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		{noindex && <meta name="robots" content="noindex, follow" />}

		<!-- Open Graph / Social Media -->
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="de_DE" />
		<meta property="og:site_name" content="Privatpraxis Kathrin Palmen" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={`${SITE}/assets/og-praxis-palmen.jpg`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta
			property="og:image:alt"
			content="Privatpraxis für Psychotherapie Kathrin Palmen in Waldkirch"
		/>
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<!-- Schema.org JSON-LD – nur auf Inhaltsseiten, nicht auf Recht/404 -->
		{
			!noindex && (
				<script
					type="application/ld+json"
					set:html={JSON.stringify(practiceSchema)}
				/>
			)
		}
		<slot name="head" />
	</head><body
		class="bg-background text-text font-sans antialiased text-base md:text-lg transition-colors duration-700 relative"
		id="body-bg"
	>
		<a
			href="#inhalt"
			class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-primary focus:text-white focus:px-5 focus:py-3 focus:rounded-full focus:shadow-lg"
		>
			Zum Inhalt springen
		</a>

		<!-- Background "Blur Orbs" -->
		<div class="fixed inset-0 z-0 pointer-events-none overflow-hidden">
			<!-- Orbs (High Visibility Mode) -->
			<!-- Orb 1: Sand/Secondary (Top Left) -->
			<div
				class="absolute top-[-10%] left-[-10%] w-[60vw] h-[60vw] bg-secondary/50 rounded-full blur-[100px] animate-float-slow"
			>
			</div>
			<!-- Orb 2: Terracotta/Accent (Top Right) -->
			<div
				class="absolute top-[10%] right-[-10%] w-[50vw] h-[50vw] bg-accent/30 rounded-full blur-[90px] animate-float-delayed"
			>
			</div>
			<!-- Orb 3: Green/Primary (Bottom Left) -->
			<div
				class="absolute bottom-[-10%] left-[20%] w-[70vw] h-[70vw] bg-primary/30 rounded-full blur-[110px] animate-pulse-slow"
			>
			</div>
		</div>
		<!-- ... Header code ... -->
		<header
			class="fixed w-full top-0 z-50 transition-all duration-500 transform bg-background/95 backdrop-blur-md"
			x-data="{
                visible: true,
                lastScrollY: 0,
                mobileMenuOpen: false,
                atTop: true
            }"
			@scroll.window="
                const currentScrollY = window.pageYOffset;
                if (currentScrollY <= 100) {
                    visible = true;
                } else if (currentScrollY > lastScrollY && currentScrollY > 100) {
                    visible = false; 
                } else {
                    visible = true;
                }
                atTop = (currentScrollY > 20) ? false : true;
                lastScrollY = currentScrollY;
            "
			:class="{ 
                '-translate-y-full': !visible, 
                'translate-y-0': visible,
                'shadow-sm py-3': !atTop, 
                'py-6': atTop 
            }"
		>
			<div
				class="container mx-auto px-6 max-w-7xl flex justify-between items-center"
			>
				<a href="/" class="flex items-center gap-3 group">
					<img
						src="/assets/logo-96.png"
						alt=""
						width="48"
						height="48"
						class="w-12 h-12 object-contain group-hover:opacity-80 transition-opacity duration-300"
					/>
					<div class="flex flex-col">
						<span
							class="font-serif text-xl md:text-2xl tracking-wide text-primary leading-none group-hover:text-text transition-colors duration-300"
						>
							Praxis Palmen
						</span>
						<span
							class="text-xs md:text-sm text-muted font-light tracking-widest uppercase"
						>
							Privatpraxis
						</span>
					</div>
				</a>

				<!-- Desktop Menu -->
				<nav
					class="hidden md:flex items-center space-x-8 text-lg font-medium"
				>
					<a
						href="/"
						class={`transition-all duration-300 border-b-2 hover:text-primary ${Astro.url.pathname === "/" ? "text-primary border-primary" : "text-text/80 border-transparent hover:border-primary/30"}`}
						>Start</a
					>
					<div class="relative group">
						<a
							href="/angebot"
							class={`transition-all duration-300 border-b-2 hover:text-primary flex items-center gap-1 ${Astro.url.pathname.startsWith("/angebot") ? "text-primary border-primary" : "text-text/80 border-transparent hover:border-primary/30"}`}
						>
							Angebot
							<svg aria-hidden="true"
								xmlns="http://www.w3.org/2000/svg"
								class="h-4 w-4 opacity-50 group-hover:opacity-100 transition-opacity"
								fill="none"
								viewBox="0 0 24 24"
								stroke="currentColor"
								><path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M19 9l-7 7-7-7"></path></svg
							>
						</a>

						<!-- Dropdown (hover UND Tastatur-Fokus – vorher nur hover) -->
						<div
							class="absolute top-full left-1/2 -translate-x-1/2 pt-6 opacity-0 translate-y-4 invisible group-hover:opacity-100 group-hover:translate-y-0 group-hover:visible group-focus-within:opacity-100 group-focus-within:translate-y-0 group-focus-within:visible transition-all duration-300 ease-out z-50"
						>
							<div
								class="bg-white/90 backdrop-blur-xl rounded-[1.5rem] shadow-xl border border-white/60 overflow-hidden w-72 p-3 ring-1 ring-black/5 relative"
							>
								<div
									class="absolute inset-0 bg-gradient-to-br from-white via-white/80 to-secondary/10 opacity-50 pointer-events-none"
								>
								</div>
								<a
									href="/angebot#psychotherapie"
									class="relative block px-5 py-4 rounded-2xl text-text/80 hover:text-primary hover:bg-white hover:shadow-sm transition-all duration-300 group/item"
								>
									<span
										class="block font-serif text-lg mb-0.5 group-hover/item:translate-x-1 transition-transform"
										>Psychotherapie</span
									>
									<span
										class="block text-xs uppercase tracking-widest text-muted"
										>Tiefenpsychologie</span
									>
								</a>
								<a
									href="/angebot#methoden"
									class="relative block px-5 py-4 rounded-2xl text-text/80 hover:text-primary hover:bg-white hover:shadow-sm transition-all duration-300 group/item mt-1"
								>
									<span
										class="block font-serif text-lg mb-0.5 group-hover/item:translate-x-1 transition-transform"
										>Ergänzende Methoden</span
									>
									<span
										class="block text-xs uppercase tracking-widest text-muted"
										>Körper, Atem, Kreativität</span
									>
								</a>
							</div>
						</div>
					</div>
					<a
						href="/ablauf-kosten"
						class={`transition-all duration-300 border-b-2 hover:text-primary ${Astro.url.pathname.startsWith("/ablauf-kosten") ? "text-primary border-primary" : "text-text/80 border-transparent hover:border-primary/30"}`}
						>Ablauf & Kosten</a
					>
					<a
						href="/ueber-mich"
						class={`transition-all duration-300 border-b-2 hover:text-primary ${Astro.url.pathname.startsWith("/ueber-mich") ? "text-primary border-primary" : "text-text/80 border-transparent hover:border-primary/30"}`}
						>Über mich</a
					>

					<!-- CTA Button Style for Contact -->
					<a
						href="/kontakt"
						class={`px-6 py-2 rounded-full border-2 border-primary bg-primary text-white transition-all duration-300 hover:-translate-y-0.5 shadow-sm hover:shadow-md hover:bg-primary/90 hover:border-primary/90`}
						>Kontakt</a
					>
				</nav>

				<!-- Mobile Menu Button -->
				<button
					@click="mobileMenuOpen = !mobileMenuOpen"
					class="md:hidden p-2 rounded-md hover:bg-secondary/10 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
					:aria-label="mobileMenuOpen ? 'Menü schließen' : 'Menü öffnen'"
					aria-label="Menü öffnen"
					:aria-expanded="mobileMenuOpen"
					aria-controls="mobile-menu"
				>
					<svg aria-hidden="true"
						class="w-6 h-6 text-text"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
						xmlns="http://www.w3.org/2000/svg"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M4 6h16M4 12h16M4 18h16"></path>
					</svg>
				</button>
			</div>

			<!-- Mobile Menu (Fade & Slide) -->
			<div
				id="mobile-menu"
				x-show="mobileMenuOpen"
				@click.away="mobileMenuOpen = false"
				x-transition:enter="transition ease-out duration-300"
				x-transition:enter-start="opacity-0 -translate-y-4"
				x-transition:enter-end="opacity-100 translate-y-0"
				x-transition:leave="transition ease-in duration-200"
				x-transition:leave-start="opacity-100 translate-y-0"
				x-transition:leave-end="opacity-0 -translate-y-4"
				class="md:hidden bg-background/95 backdrop-blur-lg absolute top-full left-0 w-full shadow-lg border-t border-secondary/10 py-6 px-6 flex flex-col space-y-6"
			>
				<a
					href="/"
					@click="mobileMenuOpen = false"
					class="block text-xl font-medium text-text hover:text-primary"
					>Start</a
				>
				<div x-data="{ expanded: false }" class="block">
					<button
						@click="expanded = !expanded"
						class="flex items-center justify-between w-full text-xl font-medium text-text hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
						:aria-expanded="expanded"
						aria-controls="mobile-angebot-submenu"
					>
						<span>Angebot</span>
						<svg aria-hidden="true"
							xmlns="http://www.w3.org/2000/svg"
							class="h-5 w-5 transition-transform duration-300"
							:class="expanded ? 'rotate-180' : ''"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
							><path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M19 9l-7 7-7-7"></path></svg
						>
					</button>
					<div
						id="mobile-angebot-submenu"
						x-show="expanded"
						x-collapse
						class="pl-4 mt-2 space-y-3 border-l-2 border-primary/10 ml-1"
					>
						<a
							href="/angebot#psychotherapie"
							@click="mobileMenuOpen = false"
							class="block text-lg text-text/80 hover:text-primary"
						>
							Psychotherapie & Beratung
						</a>
						<a
							href="/angebot#methoden"
							@click="mobileMenuOpen = false"
							class="block text-lg text-text/80 hover:text-primary"
						>
							Ergänzende Methoden
						</a>
					</div>
				</div>
				<a
					href="/ablauf-kosten"
					@click="mobileMenuOpen = false"
					class="block text-xl font-medium text-text hover:text-primary"
					>Ablauf & Kosten</a
				>
				<a
					href="/ueber-mich"
					@click="mobileMenuOpen = false"
					class="block text-xl font-medium text-text hover:text-primary"
					>Über mich</a
				>
				<a
					href="/kontakt"
					@click="mobileMenuOpen = false"
					class="block text-xl font-bold text-primary hover:text-primary/80"
					>Kontakt</a
				>
			</div>
		</header>

		<!-- Main Content Slot -->
		<main id="inhalt" class="relative z-10">
			<slot />
		</main>

		<footer class="relative z-10 pt-16 pb-8">
			<!-- Opaque background to block orbs -->
			<div class="absolute inset-0 bg-background"></div>
			<!-- Tint overlay for design -->
			<div
				class="absolute inset-0 bg-secondary/10 border-t border-secondary/20"
			>
			</div>

			<!-- Footer Content -->
			<div class="container mx-auto px-6 max-w-7xl relative">
				<div
					class="grid md:grid-cols-3 gap-12 mb-12 text-center md:text-left"
				>
					<!-- Column 1: Brand -->
					<div class="space-y-4">
						<h4 class="font-serif text-xl text-primary">
							Privatpraxis Palmen
						</h4>
						<p class="text-sm text-text/80 leading-relaxed">
							M.Sc. Psych. Kathrin Palmen<br />
							Psychologische Psychotherapeutin
						</p>
						<p class="text-xs text-muted">
							Mitglied der Landespsychotherapeutenkammer
							Baden-Württemberg
						</p>
					</div>

					<!-- Column 2: Contact -->
					<div class="space-y-4">
						<h5
							class="font-medium text-text uppercase tracking-wider text-xs"
						>
							Kontakt
						</h5>
						<p class="text-sm text-text/80 leading-relaxed">
							Schillerstraße 11<br />
							79183 Waldkirch
						</p>
						<a
							href={`tel:${TEL_LINK}`}
							class="text-sm text-primary hover:underline block"
							>{TEL_DISPLAY}</a
						>
						<a
							href="/kontakt"
							class="text-sm text-primary hover:underline block"
							>Termin vereinbaren &rarr;</a
						>
					</div>

					<!-- Column 3: Emergency -->
					<div class="space-y-4">
						<h5
							class="font-medium text-text uppercase tracking-wider text-xs"
						>
							Im Notfall
						</h5>
						<p class="text-sm text-text/80 leading-relaxed">
							Diese Praxis bietet keine Akut- oder
							Krisenversorgung. In dringenden Fällen:
						</p>
						<ul class="text-sm text-text/80 leading-relaxed space-y-1">
							<li>
								Notruf <a
									href="tel:112"
									class="font-bold text-primary hover:underline"
									>112</a
								>
							</li>
							<li>
								Ärztlicher Bereitschaftsdienst <a
									href="tel:116117"
									class="font-bold text-primary hover:underline"
									>116 117</a
								>
							</li>
							<li>
								Telefonseelsorge <a
									href="tel:08001110111"
									class="font-bold text-primary hover:underline"
									>0800 111 0 111</a
								>
								<span class="text-muted">oder</span>
								<a
									href="tel:08001110222"
									class="font-bold text-primary hover:underline"
									>0800 111 0 222</a
								>
								<span class="block text-xs text-muted"
									>kostenfrei, rund um die Uhr, anonym</span
								>
							</li>
						</ul>
					</div>
				</div>

				<!-- Bottom Bar -->
				<div
					class="border-t border-secondary/20 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-muted"
				>
					<p>&copy; {new Date().getFullYear()} Kathrin Palmen</p>
					<div class="flex space-x-6">
						<a
							href="/impressum"
							class="hover:text-primary transition-colors"
							>Impressum</a
						>
						<a
							href="/datenschutz"
							class="hover:text-primary transition-colors"
							>Datenschutz</a
						>
					</div>
				</div>
			</div>
		</footer>

		<ScrollToTop />

		<!-- Alpine & AOS Scripts -->
		<script>
			import Alpine from "alpinejs";
			import collapse from "@alpinejs/collapse";
			// @ts-ignore
			window.Alpine = Alpine;
			Alpine.plugin(collapse);
			Alpine.start();
		</script>

		<script>
			import AOS from "aos";

			// Wer reduzierte Bewegung eingestellt hat, bekommt keine Scroll-Animationen.
			// Das Sichtbarmachen der Inhalte übernimmt die @media-Regel unten in
			// <style is:global> – die greift auch, bevor dieses Skript läuft.
			if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
				AOS.init({ duration: 1000, once: true, offset: 50 });
			}
		</script>

		<style is:global>
			@keyframes float-slow {
				0% {
					transform: translate(0, 0) rotate(0deg);
				}
				33% {
					transform: translate(30px, -50px) rotate(10deg);
				}
				66% {
					transform: translate(-20px, 20px) rotate(-5deg);
				}
				100% {
					transform: translate(0, 0) rotate(0deg);
				}
			}
			@keyframes float-delayed {
				0% {
					transform: translate(0, 0) scale(1);
				}
				50% {
					transform: translate(-30px, 40px) scale(1.1);
				}
				100% {
					transform: translate(0, 0) scale(1);
				}
			}
			@keyframes pulse-slow {
				0%,
				100% {
					opacity: 0.15;
					transform: scale(1);
				}
				50% {
					opacity: 0.25;
					transform: scale(1.2);
				}
			}
			.animate-float-slow {
				animation: float-slow 15s ease-in-out infinite;
			}
			.animate-float-delayed {
				animation: float-delayed 18s ease-in-out infinite reverse;
			}
			.animate-pulse-slow {
				animation: pulse-slow 12s ease-in-out infinite;
			}

			/*
			 * Barrierefreiheit: Wer im Betriebssystem "Bewegung reduzieren"
			 * eingestellt hat, sieht eine ruhige Seite – keine schwebenden Orbs,
			 * keine Einblendungen. Relevant für Migräne, Vestibulärstörungen,
			 * Angst und ADHS, also für einen erheblichen Teil der Zielgruppe.
			 */
			@media (prefers-reduced-motion: reduce) {
				*,
				*::before,
				*::after {
					animation-duration: 0.01ms !important;
					animation-iteration-count: 1 !important;
					transition-duration: 0.01ms !important;
					scroll-behavior: auto !important;
				}
				[data-aos] {
					opacity: 1 !important;
					transform: none !important;
					transition: none !important;
				}
			}
		</style>

		{/* Ohne JavaScript setzt aos.css alle Inhalte auf opacity:0 – die Seite
		wäre leer. Dieser Fallback macht sie unbedingt sichtbar. */}
		<noscript>
