---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Impressum | Privatpraxis Kathrin Palmen">
    <section class="py-32 bg-background">
        <div class="container mx-auto px-6 max-w-4xl prose prose-lg">
            <h1 class="font-serif text-4xl mb-8">Impressum</h1>

            <p>Angaben gemäß § 5 TMG</p>

            <p>
                <strong>Privatpraxis für Psychotherapie</strong><br />
                Kathrin Palmen<br />
                Schillerstraße 11<br />
                79183 Waldkirch
            </p>

            <p>
                <strong>Kontakt:</strong><br />
                Telefon: 0163 4252042<br />
                E-Mail: kontakt@palmen-psychotherapie.de
            </p>

            <p>
                <strong>Berufsbezeichnung:</strong><br />
                Psychologische Psychotherapeutin (verliehen in der Bundesrepublik
                Deutschland)
            </p>

            <p>
                <strong>Zuständige Aufsichtsbehörde:</strong><br />
                Landespsychotherapeutenkammer Baden-Württemberg<br />
                Jägerstr. 40<br />
                70174 Stuttgart
